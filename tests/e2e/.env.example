# Copiar como tests/e2e/.env y completar. El .env no se sube a Git.

# Dirección de la web: 3000 con Podman (podman compose up), 5173 con npm run dev.
E2E_URL=http://localhost:3000

# Usuarios de prueba del seed (CLAUDE.md, «Usuarios de prueba»). Un rol sin datos se saltea.
E2E_MEDICO_CORREO=medico@mediturno.com
E2E_MEDICO_CLAVE=
E2E_PACIENTE_CORREO=paciente@mediturno.com
E2E_PACIENTE_CLAVE=
E2E_FUNCIONARIO_CORREO=funcionario@mediturno.com
E2E_FUNCIONARIO_CLAVE=
E2E_ADMIN_CORREO=admin@mediturno.com
E2E_ADMIN_CLAVE=
